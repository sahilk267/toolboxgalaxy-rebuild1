VITE_ASSET_BASE_URL=
VITE_CONTACT_ENDPOINT=

# Contact / Support Email (Email where visitor feedback will be sent)
# If left blank, defaults to support@toolboxgalaxy.com
VITE_CONTACT_EMAIL=

# Google Analytics (GA4) - Free & Industry Standard
# Enter your GA4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Alternative Cookieless Analytics (Optional: Plausible or Umami)
# Leave blank if using Google Analytics or for local development
# For Plausible:
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_API_HOST=https://plausible.io
# Or for Umami:
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# Telegram Alerts & Daily Pulse (Optional Server-Side Relay)
# Server-side only (never expose in client bundles with VITE_ prefix):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional client relay endpoint:
# VITE_TELEGRAM_RELAY_ENDPOINT=/api/telegram-relay
# SECURITY NOTICE: If a Telegram Bot Token was previously deployed with a VITE_ prefix, it must be revoked and rotated immediately via @BotFather.


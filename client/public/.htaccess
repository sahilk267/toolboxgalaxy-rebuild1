# Toolbox Galaxy SPA fallback for Hostinger Apache/LiteSpeed shared hosting.
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Conservative security headers. Confirm Hostinger supports mod_headers before publishing.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "^service-worker\.js$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Ensure modern MIME types for JavaScript modules and Web Workers on Hostinger Apache/LiteSpeed
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js .mjs
  AddType application/wasm .wasm
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

<FilesMatch "\.(js|mjs)$">
  ForceType application/javascript
  Header set Content-Type "application/javascript; charset=utf-8"
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

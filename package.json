    "verify:analytics": "tsx scripts/verify-analytics.ts",
    "verify:reminder": "tsx scripts/verify-daily-reminder.ts",
    "verify:sitemap": "tsx scripts/verify-sitemap.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:og": "tsx scripts/generate-og-images.ts",
    "verify:og": "tsx scripts/verify-og-images.ts",
    "verify:jsonld": "tsx scripts/verify-tool-jsonld.ts",
    "verify:tool-of-the-day": "tsx scripts/verify-tool-of-the-day.ts",
    "format": "prettier --write ."
